    {
      "title": "Useful Examples",
      "icon": "💡",
      "title_accent": "Useful",
      "sections": [
        {
          "label": "Practical queries",
          "kind": "code",
          "lang": "bash",
          "copy_lines": true,
          "content": "# All failed commands in current dir\natuin search --exit 1 --cwd .\n\n# Successful git commits after yesterday 3pm\natuin search --exit 0 --after \"yesterday 3pm\" git commit\n\n# Commands run in the last hour\natuin search --after \"1 hour ago\"\n\n# Find and delete command-not-found entries\natuin search --delete --exit 127\n\n# Preview pruning without deleting\natuin history prune --dry-run\n\n# Stats for last 7 days\natuin stats \"7 days ago\"\n\n# Import from custom history file\nHISTFILE=~/.zsh_custom_history atuin import zsh"
        },
        {
          "label": "Supported time formats",
          "kind": "rows",
          "items": [
            {
              "key": "Relative",
              "description": "`\"2 hours ago\"`, `\"last week\"`"
            },
            {
              "key": "Natural",
              "description": "`\"yesterday 3pm\"`, `\"Monday\"`"
            },
            {
              "key": "Absolute",
              "description": "`\"2024-01-15\"`"
            }
          ]
        }
      ]
    },
    {
      "title": "Config Reference",
      "icon": "⚙️",
      "title_accent": "Config",
      "title_note": "~/.config/atuin/config.toml",
      "layout": "wide",
      "body_cols": 2,
      "sections": [
        {
          "label": "Sync",
          "items": [
            {
              "key": "sync_address",
              "key_style": "code",
              "description": "Server URL (default: api.atuin.sh)"
            },
            {
              "key": "auto_sync",
              "key_style": "code",
              "description": "`true` / `false`"
            },
            {
              "key": "sync_frequency",
              "key_style": "code",
              "description": "`\"10m\"`, `\"1h\"`, `\"0\"` (every cmd)"
            },
            {
              "key": "network_timeout",
              "key_style": "code",
              "description": "Seconds (default: 30)"
            }
          ]
        },
        {
          "label": "UI & Keymaps",
          "items": [
            {
              "key": "theme",
              "key_style": "code",
              "description": "`\"default\"` · `\"autumn\"` · `\"marine\"`"
            },
            {
              "key": "keymap_mode",
              "key_style": "code",
              "description": "`\"emacs\"` · `\"vim-insert\"`"
            },
