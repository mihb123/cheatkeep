{
  "title": "Atuin Cheatsheet",
  "subtitle": "Magical shell history — SQLite, encrypted sync & fuzzy search",
  "description": "Complete Atuin cheatsheet: CLI commands, keyboard shortcuts, filter modes, search modes, sync setup, and config.toml reference for the magical shell history tool.",
  "source_url": "https://atuin.linuz.com/",
  "badge": "v18+",
  "logo": "atuin-logo-transp.png",
  "links": [
    {
      "label": "docs.atuin.sh",
      "url": "https://docs.atuin.sh"
    },
    {
      "label": "github.com/atuinsh/atuin",
      "url": "https://github.com/atuinsh/atuin"
    }
  ],
  "cards": [
    {
      "title": "Install & Setup",
      "icon": "⚡",
      "title_accent": "Install",
      "sections": [
        {
          "label": "Quick install",
          "kind": "code",
          "lang": "bash",
          "content": "curl --proto '=https' --tlsv1.2 -LsSf \\\n  https://setup.atuin.sh | sh"
        },
        {
          "label": "Shell init (add to rc file)",
          "kind": "code",
          "lang": "bash",
          "copy_lines": true,
          "content": "# bash\neval \"$(atuin init bash)\"\n\n# zsh\neval \"$(atuin init zsh)\"\n\n# fish\natuin init fish | source"
        },
        {
          "label": "First-time setup",
          "items": [
            {
              "key": "atuin register -u <user> -e <email>",
              "key_style": "cmd",
              "description": "Create sync account"
            },
            {
              "key": "atuin import auto",
              "key_style": "cmd",
              "description": "Import existing history"
            },
            {
              "key": "atuin sync",
              "key_style": "cmd",
              "description": "Initial sync"
            }
          ]
        },
        {
          "label": "Disable bindings",
          "items": [
            {
              "key": "atuin init zsh --disable-up-arrow",
              "key_style": "cmd",
              "description": "Disable up-arrow binding",
              "example": "eval \"$(atuin init zsh --disable-up-arrow)\""
            },
            {
              "key": "atuin init zsh --disable-ctrl-r",
              "key_style": "cmd",
              "description": "Disable Ctrl-R binding",
              "example": "eval \"$(atuin init zsh --disable-ctrl-r)\""
            }
          ]
        }
      ]
    },
    {
      "title": "Keyboard Shortcuts",
      "icon": "⌨️",
      "title_accent": "Keyboard",
      "sections": [
        {
          "label": "Navigation",
          "items": [
            {
              "key": "↑ ↓ / K J",
              "key_style": "keys",
              "description": "Move through results"
            },
            {
              "key": "← →",
              "key_style": "keys",
              "description": "Move cursor in query"
            },
            {
              "key": "Alt+0–9",
              "key_style": "keys",
              "description": "Jump to result #N"
            }
          ]
        },
        {
          "label": "Actions",
          "items": [
            {
              "key": "Enter",
              "key_style": "keys",
              "description": "Execute selected command"
            },
            {
              "key": "Tab",
              "key_style": "keys",
              "description": "Return to shell for editing"
            },
            {
              "key": "Ctrl+O",
              "key_style": "keys",
              "description": "Open command inspector"
            },
            {
              "key": "Ctrl+X",
              "key_style": "keys",
              "description": "Delete selected entry"
            },
            {
              "key": "Ctrl+C / Ctrl+D",
              "key_style": "keys",
              "description": "Cancel search"
            }
          ]
        },
        {
          "label": "Mode switching",
          "items": [
            {
              "key": "Ctrl+R",
              "key_style": "keys",
              "description": "Cycle filter mode"
            },
            {
              "key": "Ctrl+S",
              "key_style": "keys",
              "description": "Cycle search mode"
            }
          ]
        },
        {
          "label": "Vim mode",
          "items": [
            {
              "key": "Esc",
              "key_style": "keys",
              "description": "Enter vim-normal mode"
            },
            {
              "key": "I",
              "key_style": "keys",
              "description": "Return to insert mode"
            }
          ]
        }
      ]
    },
    {
      "title": "Filter Modes",
      "icon": "🔍",
      "title_accent": "Filter",
      "title_note": "(Ctrl+R)",
      "sections": [
        {
          "columns": [
            "Mode",
            "Searches"
          ],
          "items": [
            {
              "key": "global",
              "key_style": "mode",
              "description": "All history — every machine, session & directory",
              "variant": "global"
            },
            {
              "key": "host",
              "key_style": "mode",
              "description": "This machine only",
              "variant": "host"
            },
            {
              "key": "session",
              "key_style": "mode",
              "description": "Current shell session only",
              "variant": "session"
            },
            {
              "key": "session-preload",
              "key_style": "mode",
              "description": "Current session + global history from before session start",
              "note": "/ SESSION+",
              "variant": "session-preload"
            },
            {
              "key": "directory",
              "key_style": "mode",
              "description": "Current working directory only",
              "variant": "dir"
            },
            {
              "key": "workspace",
              "key_style": "mode",
              "description": "Entire git repo tree (auto in git repos)",
              "variant": "ws"
            }
          ]
        },
        {
          "label": "Search Modes (Ctrl+S)",
          "columns": [
            "Mode",
            "Behavior"
          ],
          "items": [
            {
              "key": "prefix",
              "key_style": "mode",
              "description": "Matches commands starting with your query (default)",
              "variant": "prefix"
            },
            {
              "key": "fulltext",
              "key_style": "mode",
              "description": "Matches anywhere in the command string",
              "variant": "fulltext"
            },
            {
              "key": "fuzzy",
              "key_style": "mode",
              "description": "Matches letters in any order",
              "variant": "fuzzy"
            }
          ]
        }
      ]
    },
    {
      "title": "History Commands",
      "icon": "📜",
      "title_accent": "History",
      "sections": [
        {
          "label": "Browse & search",
          "items": [
            {
              "key": "atuin history list",
              "key_style": "cmd",
              "description": "List all history"
            },
            {
              "key": "atuin history list --cmd-only",
              "key_style": "cmd",
              "description": "List commands only (no metadata)"
            },
            {
              "key": "atuin search <query>",
              "key_style": "cmd",
              "description": "Non-interactive search"
            },
            {
              "key": "atuin search -i <query>",
              "key_style": "cmd",
              "description": "Interactive TUI search"
            },
            {
              "key": "atuin search --human <query>",
              "key_style": "cmd",
              "description": "Search with human-readable timestamps"
            }
          ]
        },
        {
          "label": "Search filters",
          "items": [
            {
              "key": "--cwd <dir>",
              "key_style": "code",
              "description": "Filter by directory"
            },
            {
              "key": "--exit <code>",
              "key_style": "code",
              "description": "Filter by exit code (0 = success)"
            },
            {
              "key": "--after <time>",
              "key_style": "code",
              "description": "After a point in time"
            },
            {
              "key": "--before <time>",
              "key_style": "code",
              "description": "Before a point in time"
            },
            {
              "key": "--limit <n>",
              "key_style": "code",
              "description": "Limit result count"
            },
            {
              "key": "--human",
              "key_style": "code",
              "description": "Human-readable timestamps"
            },
            {
              "key": "--filter-mode <mode>",
              "key_style": "code",
              "description": "Set filter mode (e.g., global, host, session, directory, workspace)",
              "example": "atuin search --filter-mode directory"
            },
            {
              "key": "--search-mode <mode>",
              "key_style": "code",
              "description": "Set search mode (e.g., fuzzy, prefix, fulltext)",
              "example": "atuin search --search-mode fuzzy"
            },
            {
              "key": "--format <fmt>",
              "key_style": "code",
              "description": "Format output with {command} {time} {duration} {exit} {directory} {host} {user} {relativetime}",
              "example": "atuin search --format \"{time} {command}\""
            },
            {
              "key": "--offset <n>",
              "key_style": "code",
              "description": "Offset result count",
              "example": "atuin search --offset 10"
            },
            {
              "key": "--reverse",
              "key_style": "code",
              "description": "Reverse search results order",
              "example": "atuin search --reverse --limit 10"
            },
            {
              "key": "--cmd-only",
              "key_style": "code",
              "description": "Print only the command (no metadata)",
              "example": "atuin search --cmd-only curl"
            },
            {
              "key": "--exclude-exit <code>",
              "key_style": "code",
              "description": "Exclude commands with specific exit code",
              "example": "atuin search --exclude-exit 1"
            },
            {
              "key": "--exclude-cwd <dir>",
              "key_style": "code",
              "description": "Exclude commands from specific directory",
              "example": "atuin search --exclude-cwd /tmp"
            },
            {
              "key": "--inline-height <lines>",
              "key_style": "code",
              "description": "Set inline height for TUI search",
              "example": "atuin search -i --inline-height 20"
            }
          ]
        },
        {
          "label": "Delete & prune",
          "items": [
            {
              "key": "atuin search --delete <query>",
              "key_style": "cmd",
              "description": "Delete matching entries"
            },
            {
              "key": "atuin history prune --dry-run",
              "key_style": "cmd",
              "description": "Preview what prune removes"
            },
            {
              "key": "atuin history prune",
              "key_style": "cmd",
              "description": "Remove filtered entries"
            },
            {
              "key": "atuin history dedup",
              "key_style": "cmd",
              "description": "Remove exact duplicates"
            },
            {
              "key": "atuin search --delete-it-all",
              "key_style": "cmd",
              "description": "Delete all history matching the query",
              "example": "atuin search --delete-it-all curl",
              "danger": "Irreversibly deletes all matching history"
            }
          ]
        },
        {
          "label": "History List",
          "items": [
            {
              "key": "atuin history list --cwd <dir>",
              "key_style": "cmd",
              "description": "List history for directory",
              "example": "atuin history list --cwd /tmp"
            },
            {
              "key": "atuin history list --session <id>",
              "key_style": "cmd",
              "description": "List history for session",
              "example": "atuin history list --session 123"
            },
            {
              "key": "atuin history list --human",
              "key_style": "cmd",
              "description": "Use human-readable time",
              "example": "atuin history list --human --limit 5"
            },
            {
              "key": "atuin history list --cmd-only",
              "key_style": "cmd",
              "description": "List only commands"
            },
            {
              "key": "atuin history list --format <fmt>",
              "key_style": "cmd",
              "description": "Format output",
              "example": "atuin history list --format \"{time} {command}\""
            },
            {
              "key": "atuin history list --print0",
              "key_style": "cmd",
              "description": "End each line with a null byte",
              "example": "atuin history list --print0 | xargs -0"
            },
            {
              "key": "atuin history list --reverse",
              "key_style": "cmd",
              "description": "Reverse history order",
              "example": "atuin history list --reverse --limit 10"
            },
            {
              "key": "atuin history list --timezone <tz>",
              "key_style": "cmd",
              "description": "List history in specific timezone",
              "example": "atuin history list --timezone UTC"
            }
          ]
        },
        {
          "label": "History Prune & Dedup",
          "items": [
            {
              "key": "atuin history prune --dry-run",
              "key_style": "cmd",
              "description": "Preview prune without deleting"
            },
            {
              "key": "atuin history prune --before <time>",
              "key_style": "cmd",
              "description": "Prune history before time",
              "example": "atuin history prune --before \"30 days ago\""
            },
            {
              "key": "atuin history dedup",
              "key_style": "cmd",
              "description": "Deduplicate history",
              "example": "atuin history dedup && atuin status"
            },
            {
              "key": "atuin history dedup --dry-run",
              "key_style": "cmd",
              "description": "Preview deduplication",
              "example": "atuin history dedup --dry-run | wc -l"
            },
            {
              "key": "atuin history dedup --dupkeep <keep>",
              "key_style": "cmd",
              "description": "Keep first or last duplicate (first, last)",
              "example": "atuin history dedup --dupkeep first"
            }
          ]
        },
        {
          "label": "Store",
          "items": [
            {
              "key": "atuin store status",
              "key_style": "cmd",
              "description": "Show store status"
            },
            {
              "key": "atuin store rebuild <tag>",
              "key_style": "cmd",
              "description": "Rebuild a tag in the store (e.g. history)",
              "example": "atuin store rebuild history"
            },
            {
              "key": "atuin store rekey",
              "key_style": "cmd",
              "description": "Change encryption key",
              "example": "atuin store rekey && atuin sync"
            },
            {
              "key": "atuin store purge",
              "key_style": "cmd",
              "description": "Purge deleted items from the local store",
              "example": "atuin store purge && atuin status"
            },
            {
              "key": "atuin store verify",
              "key_style": "cmd",
              "description": "Verify integrity of the store"
            },
            {
              "key": "atuin store push",
              "key_style": "cmd",
              "description": "Push store to server",
              "example": "atuin store push && atuin sync"
            },
            {
              "key": "atuin store pull",
              "key_style": "cmd",
              "description": "Pull store from server",
              "example": "atuin store pull && atuin sync"
            }
          ]
        },
        {
          "label": "Key-Value Store (kv)",
          "items": [
            {
              "key": "atuin kv set <namespace> <key> <value>",
              "key_style": "cmd",
              "description": "Set a key-value pair",
              "example": "atuin kv set myapp theme dark"
            },
            {
              "key": "atuin kv get <namespace> <key>",
              "key_style": "cmd",
              "description": "Get a value by key",
              "example": "atuin kv get myapp theme"
            },
            {
              "key": "atuin kv list <namespace>",
              "key_style": "cmd",
              "description": "List keys in a namespace",
              "example": "atuin kv list myapp"
            }
          ]
        },
        {
          "label": "Dotfiles",
          "items": [
            {
              "key": "atuin dotfiles alias set <name> <value>",
              "key_style": "cmd",
              "description": "Set a dotfiles alias",
              "example": "atuin dotfiles alias set k kubectl"
            },
            {
              "key": "atuin dotfiles alias delete <name>",
              "key_style": "cmd",
              "description": "Delete a dotfiles alias",
              "example": "atuin dotfiles alias delete k"
            },
            {
              "key": "atuin dotfiles alias list",
              "key_style": "cmd",
              "description": "List dotfiles aliases"
            },
            {
              "key": "atuin dotfiles var set <name> <value>",
              "key_style": "cmd",
              "description": "Set a dotfiles variable",
              "example": "atuin dotfiles var set EDITOR nvim"
            },
            {
              "key": "atuin dotfiles var delete <name>",
              "key_style": "cmd",
              "description": "Delete a dotfiles variable",
              "example": "atuin dotfiles var delete EDITOR"
            },
            {
              "key": "atuin dotfiles var list",
              "key_style": "cmd",
              "description": "List dotfiles variables"
            }
          ]
        },
        {
          "label": "Scripts",
          "items": [
            {
              "key": "atuin scripts new <name>",
              "key_style": "cmd",
              "description": "Create a new script",
              "example": "atuin scripts new build"
            },
            {
              "key": "atuin scripts run <name>",
              "key_style": "cmd",
              "description": "Run a script",
              "example": "atuin scripts run build"
            },
            {
              "key": "atuin scripts list",
              "key_style": "cmd",
              "description": "List available scripts"
            },
            {
              "key": "atuin scripts get <name>",
              "key_style": "cmd",
              "description": "View script content",
              "example": "atuin scripts get build"
            },
            {
              "key": "atuin scripts edit <name>",
              "key_style": "cmd",
              "description": "Edit a script",
              "example": "atuin scripts edit build"
            },
            {
              "key": "atuin scripts delete <name>",
              "key_style": "cmd",
              "description": "Delete a script",
              "example": "atuin scripts delete build",
              "danger": "Permanently deletes the script"
            }
          ]
        }
      ]
    },
    {
