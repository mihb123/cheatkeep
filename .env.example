# Database configuration (PostgreSQL + pgvector)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=cheatsheet
POSTGRES_USER=cheatsheet
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql://cheatsheet:change_this_password@127.0.0.1:5434/cheatsheet

# Web Server
APP_HOST=127.0.0.1
APP_PORT=8080

# Embedding (Ollama native)
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3
EMBED_DIM=1024
